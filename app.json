{
  "expo": {
    "name": "한국어 상식 퀴즈",
    "slug": "3ha-korean-quiz",
    "scheme": "koreaquiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/main-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tha.koreaquiz",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "사용자님께 더 관련성 높은 광고를 제공하기 위해 기기의 광고 식별자 사용 권한이 필요합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json",
      "fr": "./locales/fr.json"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDEFD6",
        "foregroundImage": "./assets/mascot/mascot-foreground.png",
        "monochromeImage": "./assets/main-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.tha.koreaquiz"
    },
    "web": {
      "favicon": "./assets/main-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-bootsplash",
        {
          "logo": "./assets/bootsplash/logo.png",
          "background": "#f6daaa",
          "assetsOutput": "assets/bootsplash"
        }
      ],
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBAnalytics",
              "RNFBApp",
              "RNFBCrashlytics"
            ]
          },
          "android": {}
        }
      ],
      "expo-asset",
      "@react-native-firebase/crashlytics",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1996095472780376~6931027351",
          "iosAppId": "ca-app-pub-1996095472780376~9191922282"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "AppTrackingTransparency",
            "Notifications"
          ]
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4125cad1-b423-4398-9683-d676ee94bbf0"
      }
    },
    "owner": "ecodelab",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/4125cad1-b423-4398-9683-d676ee94bbf0"
    }
  }
}
