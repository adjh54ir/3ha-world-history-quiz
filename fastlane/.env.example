# fastlane 환경변수 템플릿
# 이 파일을 fastlane/.env 로 복사한 뒤 값을 채우세요. (.env 는 커밋 금지)

# ───── 공통 ─────
IOS_BUNDLE_ID=com.tha.lifehanja
ANDROID_PACKAGE=com.tha.lifehanja
CHANGELOG=버그 수정 및 개선

# ───── iOS / App Store Connect ─────
APPLE_ID=your-apple-id@example.com
APPLE_TEAM_ID=XXXXXXXXXX            # Apple Developer 팀 ID
ITC_TEAM_ID=                        # App Store Connect 팀 ID(여러 팀일 때)
# App Store Connect API 키(권장: 2FA 회피). 셋 다 채우면 자동 사용됨.
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=./fastlane/AuthKey.p8

# match (코드사이닝 git 저장소)
MATCH_GIT_URL=git@github.com:your-org/certificates.git
MATCH_PASSWORD=                      # match 암호화 비밀번호
MATCH_READONLY=true

# 제출/출시 옵션
SUBMIT_FOR_REVIEW=false
AUTO_RELEASE=false
BUILD_NUMBER=                        # 비우면 타임스탬프 사용

# ───── Android / Google Play ─────
PLAY_JSON_KEY_FILE=./fastlane/play-service-account.json

# ───── Firebase App Distribution (선택) ─────
FIREBASE_IOS_APP_ID=1:000000000000:ios:xxxxxxxxxxxx
FIREBASE_ANDROID_APP_ID=1:000000000000:android:xxxxxxxxxxxx
FIREBASE_TESTER_GROUPS=testers
FIREBASE_TOKEN=                      # 또는 GOOGLE_APPLICATION_CREDENTIALS 사용
