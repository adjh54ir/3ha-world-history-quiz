EXPO_PUBLIC_APP_MODE=local
EXPO_PUBLIC_API_URL=http://localhost:8080

# ===== 앱 메타 =====
EXPO_PUBLIC_APP_NAME=세계 상식 퀴즈
EXPO_PUBLIC_APP_DESCRIPTION=세계의 수도·랜드마크·위인·신화·천체·스포츠를 주제별로 배우는 세계 상식 퀴즈 앱입니다.
# TODO: 정식 출시 후 실제 스토어 URL 입력 (미입력 시 "출시 예정"으로 처리됨)
EXPO_PUBLIC_GOOGLE_PLAY_STORE_URL=
EXPO_PUBLIC_APP_STORE_URL=

EXPO_PUBLIC_GOOGLE_ADMOV_ANDROID_BANNER=ca-app-pub-1996095472780376/9202851958
EXPO_PUBLIC_GOOGLE_ADMOV_IOS_BANNER=ca-app-pub-1996095472780376/2737515956

EXPO_PUBLIC_GOOGLE_ADMOV_ANDROID_FRONT=ca-app-pub-1996095472780376/5319396936
EXPO_PUBLIC_GOOGLE_ADMOV_IOS_FRONT=ca-app-pub-1996095472780376/8007667279

EXPO_PUBLIC_GOOGLE_ADMOV_ANDROID_REWARD=ca-app-pub-1
EXPO_PUBLIC_GOOGLE_ADMOV_IOS_REWARD=ca-app-pub-1

# IAP 광고제거 상품 키 (필요시 입력)
EXPO_PUBLIC_IAP_REMOVE_AD_KEY=

# 앱 오프닝(App Open) 광고 — 값이 비어 있으면 테스트 광고로 동작
EXPO_PUBLIC_GOOGLE_ADMOV_ANDROID_OPEN_APP=ca-app-pub-1996095472780376/7695819851
EXPO_PUBLIC_GOOGLE_ADMOV_IOS_OPEN_APP=ca-app-pub-1996095472780376/2854556718

# ⚠️ 아래 4종은 AdMob 콘솔 "세계 상식 퀴즈" 앱에서 유닛 생성 후 채울 것.
#    비어 있으면 운영 빌드에서도 테스트 광고로 폴백된다.
EXPO_PUBLIC_GOOGLE_ADMOV_ANDROID_REWARD_FRONT=
EXPO_PUBLIC_GOOGLE_ADMOV_IOS_REWARD_FRONT=
EXPO_PUBLIC_GOOGLE_ADMOV_ANDROID_NATIVE_ADVANCED=
EXPO_PUBLIC_GOOGLE_ADMOV_IOS_NATIVE_ADVANCED=

# Supabase (랭킹·리그·백업·구매 기록) — 세계 상식 퀴즈 전용 프로젝트를 만든 뒤 채울 것.
# 비어 있으면 랭킹·백업이 '서버 준비 중' 으로 동작한다 (SupabaseClient.isSupabaseConfigured).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
