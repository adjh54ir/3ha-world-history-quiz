{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    // node --test 로 돌리는 규칙 테스트가 확장자까지 적어야 해서 (noEmit 이라 번들에는 영향 없음)
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*", "./src/*", "./app/*", "./assets/*"],
      "@env": ["./src/const/EnvCompat"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "jsx": "react-native",
    "lib": ["es2017", "es2018", "dom"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2017"
  },
  "include": [
    "__mocks__/**/*",
    "./app/**/*",
    "./src/**/*",
    "index.d.ts",
    "env.d.ts",
    ".eslint.config.js",
    "jest.setup.js",
    "jest.config.js",
    "babel.config.js",
    "index.js",
    "react-native.config.js",
    "jest.setup.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "_",
    "android",
    "ios"
  ]
}
